# Copier en .env : cp .env.example .env
APP_VERSION=1.0.0
GIT_COMMIT=local

# Secret de signature des jetons JWT. Obligatoire hors développement : génère-le avec
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=a-remplacer
# Durée de validité d'un jeton, en minutes
JWT_EXPIRES_MINUTES=480

# Compte administrateur créé au démarrage s'il n'existe pas
ADMIN_EMAIL=admin@novaservices.fr
ADMIN_PASSWORD=a-remplacer

# 1 = remplit une base vide avec des comptes et un mois de tickets fictifs
SEED_DEMO=1
# Mot de passe des comptes de démonstration
DEMO_PASSWORD=novaservices

# Base de données (par défaut : instance/novaservices.db)
# DATABASE_URL=sqlite:///novaservices.db
